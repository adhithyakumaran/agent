{
  "name": "scoutai",
  "version": "0.1.0",
  "private": true,
  "description": "ScoutAI — intelligent QA discovery and automation platform (foundation)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "check": "npm run build && npm run check:boundaries",
    "test": "npm run test:unit && npm run test:boundaries && npm run test:e2e",
    "test:unit": "vitest run --exclude tests/unit/boundary-violation.test.ts",
    "test:boundaries": "vitest run tests/unit/boundary-violation.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.18.6",
    "dependency-cruiser": "^17.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
